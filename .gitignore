# === Hinaing root ignores ===
# python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# 7-node agent harness evaluation experiment (2 models)
#   - backend/data/metrics/*.jsonl  -> tracked production + eval run logs
#   - backend/backend/data/metrics/ -> stale duplicate copies (ignored)
#   - backend/backend/             -> stale duplicate copies (ignored)
# The committed dataset is the thesis faithfulness corpus:
#   37 files / 329 runs / 820 verified claims / 100% faithfulness.
# Reproducible via backend/scripts/audit_faithfulness_metrics.py.
backend/backend/data/metrics/
backend/backend/
backend/logs/
logs/
*.jsonl
!backend/benchmarks/data/*.json
!backend/data/metrics/*.jsonl

# telemetry
backend/.deepeval_telemetry.txt
*.log

# vector db
qdrant_data/
backend/qdrant_data/

# local agent scaffolding
.agent/
.kilo/
.qwen/
.vscode/
nul
backend/nul

# results / scratch
backend/results/
backend/scripts/data/
backend/scripts/benchmark_data/
backend/scripts/faithfulness/
backend/data/baselines.json

# per-run thesis artifacts
docs/ablation-run-*/
docs/full-run-*/
docs/api-cost-reduction-*/
docs/faithfulness-*/
